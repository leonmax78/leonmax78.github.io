{"n":"樓蘭公主幽魂","t":16329,"msgs":{"16329":{"m":"沒想到你們竟闖進這魔陣裡，可惜當我發現時已有不少死傷，來不及解救他們…唉，這寶物你拿去吧，多少有點幫助，以後可得謹慎點行事，別再如此莽撞了。","f":2337,"n":[101038]},"101037":{"m":"傳送回城","p":1,"tr":[{"a":["傳送"]}]},"101038":{"m":"安慰獎，回城","f":2337,"tr":[{"c":["等級 ≥ 800"],"a":["獲得「天帝寶戒」×1"],"j":101037},{"c":["等級 ≥ 600"],"a":["獲得「天尊寶綴」×1"],"j":101037},{"c":["等級 ≥ 500"],"a":["獲得「天啟寶綴」×1"],"j":101037},{"c":["等級 ≥ 400"],"a":["獲得「天闕寶戒」×1"],"j":101037},{"c":["等級 ≥ 300"],"a":["獲得「天魁寶戒」×1"],"j":101037},{"c":["等級 ≥ 250"],"a":["獲得「天權寶戒」×1"],"j":101037},{"c":["等級 ≥ 50"],"a":["獲得「天璇寶戒」×1"],"j":101037}],"n":[101037]}}}